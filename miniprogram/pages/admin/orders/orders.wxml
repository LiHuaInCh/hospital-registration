<admin-nav active="orders" />

<view class="admin-page">
  <view class="admin-head">
    <text class="admin-title">挂号单</text>
    <text class="admin-count">共 {{total}} 条</text>
  </view>
  <text class="admin-sub">可按状态与就诊日期筛选，并更新签到 / 完成状态</text>

  <view class="seg">
    <view
      class="seg-item {{currentTab === index ? 'on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="label"
      data-index="{{index}}"
      bindtap="switchTab"
    >{{item.label}}</view>
  </view>

  <view class="filter-bar">
    <picker mode="date" value="{{date}}" bindchange="onDateChange">
      <view class="filter-date">{{date || '全部日期'}}</view>
    </picker>
    <text class="filter-clear" wx:if="{{date}}" bindtap="clearDate">清除日期</text>
    <text class="filter-clear" wx:else>按就诊日期筛选</text>
  </view>

  <view class="panel" wx:if="{{orders.length}}">
    <view class="admin-item" wx:for="{{orders}}" wx:key="id">
      <view class="admin-item-main">
        <view class="row-title">
          {{item.patientName}}
          <text class="status status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <text class="row-sub">{{item.departmentName}}　{{item.doctorName}}</text>
        <text class="row-sub">{{item.dateText}}　{{item.timeText}}　¥{{item.fee}}</text>
      </view>
      <view class="admin-actions">
        <text wx:if="{{item.canCheckIn}}" data-id="{{item.id}}" data-act="checkin" bindtap="act">签到</text>
        <text wx:if="{{item.canFinish}}" data-id="{{item.id}}" data-act="finish" bindtap="act">完成</text>
        <text class="danger" wx:if="{{item.canCancel}}" data-id="{{item.id}}" data-act="cancel" bindtap="act">取消</text>
      </view>
    </view>
  </view>

  <empty-state wx:if="{{!loading && !orders.length}}" text="没有符合条件的挂号单" hint="试试切换状态或日期" />

  <view class="load-more" wx:if="{{loadingMore}}">加载中…</view>
  <view class="load-more" wx:elif="{{hasMore}}">上拉加载更多</view>
</view>
